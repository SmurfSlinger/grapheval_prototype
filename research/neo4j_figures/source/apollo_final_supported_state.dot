digraph G {
  rankdir=LR;
  node [shape=box, style=rounded];
  "Neil Armstrong";
  "Wapakoneta";
  "Ohio";
  "United States";
  "Washington, D.C.";
  "Potomac River";
  "Chesapeake Bay";
  "Atlantic Ocean";
  "Neil Armstrong" -> "Wapakoneta" [label="was_born_in", color="green", style="solid"];
  "Wapakoneta" -> "Ohio" [label="is_located_in", color="green", style="solid"];
  "Ohio" -> "United States" [label="is_part_of", color="green", style="solid"];
  "United States" -> "Washington, D.C." [label="has_capital_in", color="green", style="solid"];
  "Washington, D.C." -> "Potomac River" [label="is_located_on", color="green", style="solid"];
  "Potomac River" -> "Chesapeake Bay" [label="flows_to", color="green", style="solid"];
  "Chesapeake Bay" -> "Atlantic Ocean" [label="opens_into", color="green", style="solid"];
  "Chesapeake Bay" -> "Atlantic Ocean" [label="opens_into [SUPPORTED iter=2]", color="blue", style="solid"];
  "Potomac River" -> "Chesapeake Bay" [label="flows_to [SUPPORTED iter=2]", color="blue", style="solid"];
  "Washington, D.C." -> "Potomac River" [label="is_located_on [SUPPORTED iter=2]", color="blue", style="solid"];
}
